  "components": {
    "schemas": {
      "AccessRequest": {
        "required": [
          "key"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateSessionRequest": {
        "required": [
          "presentationId"
        ],
        "type": "object",
        "properties": {
          "presentationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DisplayAccess": {
        "required": [
          "sessionId"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DisplayToken": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "ImportFailure": {
        "enum": [
          "ConversionFailed",
          "ConversionTimedOut",
          "SlideCountMismatch",
          "Unexpected",
          null
        ]
      },
      "ImportStatus": {
        "enum": [
          "Pending",
          "Processing",
          "Ready",
          "Failed"
        ]
      },
      "JoinInfo": {
        "required": [
          "title",
          "noticeVersion"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "noticeVersion": {
            "type": "string"
          }
        }
      },
      "JoinRequest": {
        "required": [
          "name",
          "email",
          "consent"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "consent": {
            "type": "boolean"
          }
        }
      },
      "JoinResult": {
        "required": [
          "sessionId"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PresentationDetail": {
        "required": [
          "id",
          "title",
          "status",
          "failure",
          "createdAt",
          "slides"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ImportStatus"
          },
          "failure": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ImportFailure"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "slides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlideDetail"
            }
          }
        }
      },
      "PresentationSummary": {
        "required": [
          "id",
          "title",
          "status",
          "failure",
          "slideCount",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ImportStatus"
          },
          "failure": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ImportFailure"
              }
            ]
          },
          "slideCount": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RedeemDisplayTokenRequest": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SessionDetail": {
        "required": [
          "id",
          "code",
          "status",
          "slideIndex",
          "stepIndex",
          "presentationId",
          "title",
          "slides"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "slideIndex": {
            "type": "integer",
            "format": "int32"
          },
          "stepIndex": {
            "type": "integer",
            "format": "int32"
          },
          "presentationId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "slides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SlideDetail"
            }
          }
        }
      },
      "SessionInfo": {
        "required": [
          "id",
          "code",
          "status",
          "presentationId",
          "title"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "presentationId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "SessionStatus": {
        "enum": [
          "Lobby",
          "Live",
          "Ended"
        ]
      },
      "SlideDetail": {
        "required": [
          "index",
          "speakerNotes",
          "stepCount"
        ],
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "speakerNotes": {
            "type": "string"
          },
          "stepCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
