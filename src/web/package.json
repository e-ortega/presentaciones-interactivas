{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:api": "npx --yes openapi-typescript@7.13.0 src/api/openapi.json --output src/api/schema.d.ts",
    "prepare": "node husky-install.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
