# Copy to .env (ignored by git) and fill in. Never commit real values: the repo is public.

# SQL Server needs 8+ characters with upper case, lower case, digits and symbols.
# Avoid ';' and '$': they break the connection string and Compose interpolation.
MSSQL_SA_PASSWORD=

# Hex SHA-256 of the teacher access key (D-45). Empty = the teacher area rejects every key.
ADMIN_ACCESS_KEY_SHA256=
