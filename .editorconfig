root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csproj,props,slnx}]
indent_size = 4

[*.{ts,tsx,css,json,yml,yaml,md}]
indent_size = 2

[*.cs]
# Style
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Analyzer rules turned off on purpose. Every other recommended rule fails the build.
# CA1848, CA1873: LoggerMessage delegates are a micro-optimization for hot paths; this app logs a few lines per import.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# CA1711: names like ImportQueue say what the type is.
dotnet_diagnostic.CA1711.severity = none

# EF Core migrations are generated: never edited by hand, so not analyzed.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[tests/**/*.cs]
# Test names read as sentences: An_uploaded_deck_becomes_slides.
dotnet_diagnostic.CA1707.severity = none
# xUnit creates test classes itself; there is no synchronization context to worry about.
dotnet_diagnostic.CA2007.severity = none
